# =============================================================================
# NSOC — Sentinel AI EDR — Variables de entorno
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (usado por docker-compose y el backend Go)
# -----------------------------------------------------------------------------

# Usuario de la base de datos
POSTGRES_USER=<CAMBIAR>

# Contraseña de la base de datos — usa una cadena larga y aleatoria en producción
POSTGRES_PASSWORD=<CAMBIAR>

# Nombre de la base de datos
POSTGRES_DB=<CAMBIAR>

# Puerto expuesto en el host (por defecto 5432)
POSTGRES_PORT=5432

# URL de conexión completa que consume el backend Go (construída con los valores anteriores)
# Formato: postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<host>:<POSTGRES_PORT>/<POSTGRES_DB>?sslmode=disable
# — En desarrollo local (sin Docker) el host es localhost
# — Si el backend corre dentro de Docker Compose, reemplaza localhost por "postgres"
DATABASE_URL=postgres://<CAMBIAR>:<CAMBIAR>@localhost:5432/<CAMBIAR>?sslmode=disable

# -----------------------------------------------------------------------------
# Brain (Python) — LLM Backend
# -----------------------------------------------------------------------------

# Selecciona el backend LLM: "true" = Ollama local, "false" = Cloudflare Workers AI
USE_LOCAL_LLM=true

# --- Ollama (local) ---
# Requiere 16 GB+ RAM. Descarga el modelo con: ollama pull llama3
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3
# Tiempo máximo de espera para la respuesta del LLM (segundos)
OLLAMA_TIMEOUT=30

# --- Cloudflare Workers AI (cloud) ---
# Obtén tu Account ID y API Token en: https://dash.cloudflare.com/profile/api-tokens
# El token debe tener permiso "Workers AI:Read"
CLOUDFLARE_ACCOUNT_ID=<CAMBIAR>
CLOUDFLARE_API_TOKEN=<CAMBIAR>
# Modelo a usar en Cloudflare Workers AI
CLOUDFLARE_MODEL=@cf/meta/llama-3-8b-instruct

# -----------------------------------------------------------------------------
# Brain (Python) — Servidor HTTP
# -----------------------------------------------------------------------------

# Puerto en que escucha el servidor HTTP del Brain
BRAIN_PORT=5000

# URL del Brain (Python) a la que el backend hace forward de eventos
# Debe coincidir con BRAIN_PORT
BRAIN_URL=http://localhost:5000/analyze

# Timeout del cliente HTTP que el backend usa para llamar al Brain
# Aumentar si se usa un LLM cloud lento (ej. Cloudflare en cold start)
# Formato Go duration: 30s, 1m, etc.
BRAIN_TIMEOUT=30s

# -----------------------------------------------------------------------------
# Backend Go — URLs de servicios internos
# -----------------------------------------------------------------------------

# Puerto en que escucha el backend
BACKEND_PORT=8080
# URL completa del backend al que el agente envía telemetría
# Debe coincidir con BACKEND_PORT
BACKEND_URL=http://localhost:8080
